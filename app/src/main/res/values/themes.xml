<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        A aplicacao usa Jetpack Compose para toda a interface. Este tema serve
        apenas de base para a Activity: e derivado de AppCompat porque a troca
        de idioma recorre a API de idiomas por aplicacao do AppCompat.
    -->
    <style name="Theme.VivaRacing" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
